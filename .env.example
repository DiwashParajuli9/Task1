# Database (PostgreSQL — use Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_chat"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# OAuth — Google (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth — GitHub (https://github.com/settings/developers)
GITHUB_ID=""
GITHUB_SECRET=""

# LLM (server-side only — never expose to the browser)
OPENAI_API_KEY=""
# Optional: use Azure, Groq, Together, or local Ollama
OPENAI_BASE_URL="https://api.openai.com/v1"
DEFAULT_MODEL="gpt-4o-mini"

# Rate limiting (optional — falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# File uploads (stored under public/uploads in dev)
MAX_UPLOAD_MB="10"
